name = "betha-bi-api"
main = "worker.js"
compatibility_date = "2026-09-30"

[vars]
ALLOWED_ORIGINS = "https://uelitonbueno-creator.github.io"
BETHA_BI_API_BASE = "https://tributos.suite.betha.cloud"

# Fonte base do Tributos: preencher quando a API oficial correspondente for mapeada.
BETHA_BASE_API_BASE = ""
BETHA_BASE_RESOURCE_MAP_JSON = "{}"

# Segurança: manter false em produção.
ALLOW_UNAUTHENTICATED_DEV = "false"

# NÃO colocar valores secretos neste arquivo.
# Configurar como secrets:
#   wrangler secret put BETHA_ACCESS_TOKEN
#   wrangler secret put BETHA_TENANTS_JSON
